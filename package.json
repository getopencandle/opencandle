{
  "name": "opencandle",
  "productName": "OpenCandle",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Free, source-available desktop charting app: indicators, drawings, replay, alerts, scripting, strategy testing and paper trading with your own data. No account, no telemetry.",
  "keywords": ["charting", "technical-analysis", "trading", "indicators", "backtesting", "paper-trading", "electron", "desktop"],
  "homepage": "https://getopencandle.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getopencandle/opencandle.git"
  },
  "bugs": {
    "url": "https://github.com/getopencandle/opencandle/issues"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "OpenCandle contributors",
  "main": "electron/main.cjs",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "postinstall": "node src/chart/apply-vela-compat-patch.mjs --apply",
    "predev": "node src/chart/apply-vela-compat-patch.mjs --verify",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node src/chart/apply-vela-compat-patch.mjs --verify",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "pretest": "node src/chart/apply-vela-compat-patch.mjs --verify",
    "test": "vitest run --no-fs-module-cache --no-cache",
    "pretest:watch": "node src/chart/apply-vela-compat-patch.mjs --verify",
    "test:watch": "vitest --no-fs-module-cache --no-cache",
    "start": "electron .",
    "package": "npm run build && node scripts/package.mjs",
    "package:verify": "node scripts/security-package.mjs"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "6.2.5",
    "@luxalgo/vela": "0.8.4",
    "codemirror": "6.0.2",
    "decimal.js": "10.6.0",
    "quickjs-emscripten": "0.32.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "overrides": {
    "@electron/packager": {
      "extract-zip": "npm:@electron-internal/extract-zip@1.0.5"
    },
    "@electron/get@4.0.3": {
      "global-agent": "4.1.3"
    }
  },
  "devDependencies": {
    "@electron/fuses": "2.1.2",
    "@electron/packager": "19.0.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "electron": "44.7.2",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
